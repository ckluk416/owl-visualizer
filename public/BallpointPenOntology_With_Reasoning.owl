<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.com/BallpointPenOntology/"
         xmlns="http://example.com/BallpointPenOntology/">

<owl:Ontology rdf:about="http://example.com/BallpointPenOntology">
  <owl:versionIRI rdf:resource="1.0.0"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A knowledge model for describing several types of ballpoint pens based on their components, characteristics and make.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="hasCharacteristic">
  <rdfs:subPropertyOf rdf:resource="hasFeature"/>
  <owl:inverseOf rdf:resource="isCharacteristicOf"/>
  <rdfs:domain rdf:resource="Pen"/>
  <rdfs:range rdf:resource="PenCharacteristic"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasFeature">
  <owl:inverseOf rdf:resource="isFeatureOf"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="isCharacteristicOf">
  <rdfs:subPropertyOf rdf:resource="isFeatureOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="hasComponent">
  <rdfs:subPropertyOf rdf:resource="hasFeature"/>
  <owl:inverseOf rdf:resource="isComponentOf"/>
  <rdfs:domain rdf:resource="Pen"/>
  <rdfs:range rdf:resource="PenComponent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="isComponentOf">
  <rdfs:subPropertyOf rdf:resource="isFeatureOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="isFeatureOf"/>

<owl:ObjectProperty rdf:about="hasMake">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="hasWidestDiameterInMillimetres">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="Pen">
  <rdfs:subClassOf rdf:resource="WritingImplement"/>
</owl:Class>

<owl:Class rdf:about="PenCharacteristic"/>

<owl:Class rdf:about="PenComponent"/>

<owl:Class rdf:about="BallPoint">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="BallpointPen">
  <rdfs:subClassOf rdf:resource="Pen"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasComponent"/>
      <owl:someValuesFrom rdf:resource="BallPoint"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasComponent"/>
      <owl:someValuesFrom rdf:resource="InkReservoir"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasComponent"/>
      <owl:someValuesFrom rdf:resource="Socket"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ballpoint pen, also known as 'biro' and 'ball pen' is a pen that dispenses ink over a metal ball at its point, i.e. over a 'ball point' (Wikipedia).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="InkReservoir">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="Socket">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="BicCristal">
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasComponent"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="BallPoint"/>
            <rdf:Description rdf:about="BlindCap"/>
            <rdf:Description rdf:about="Cap"/>
            <rdf:Description rdf:about="InkReservoir"/>
            <rdf:Description rdf:about="SinglePenBody"/>
            <rdf:Description rdf:about="Socket"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasCharacteristic"/>
      <owl:hasValue rdf:resource="Disposable"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasMake"/>
      <owl:hasValue rdf:resource="Bic"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="DisposableBallpointPen"/>
</owl:Class>

<owl:Class rdf:about="BlindCap">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="Cap">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="SinglePenBody">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="ChunkyBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasWidestDiameterInMillimetres"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">13.5</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="CustomBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Customized"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="DesignerBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Expensive"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Refillable"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="RefillableBallpointPen"/>
</owl:Class>

<owl:Class rdf:about="DisposableBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Disposable"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="ErasableInkBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="ErasableInk"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="UpsideDownUsage"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="FisherSpacePen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="UnderWaterUsage"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="UpsideDownUsage"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="ZeroGravityUsage"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasMake"/>
          <owl:hasValue rdf:resource="Fisher"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="SpacePen"/>
</owl:Class>

<owl:Class rdf:about="FountainPen">
  <rdfs:subClassOf rdf:resource="Pen"/>
</owl:Class>

<owl:Class rdf:about="LowerPenBody">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="MultiColourBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Multicolour"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasComponent"/>
          <owl:onClass rdf:resource="BallPoint"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="MyInnovativeBallpointPen">
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasComponent"/>
      <owl:someValuesFrom rdf:resource="RetractableMechanism"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasCharacteristic"/>
      <owl:hasValue rdf:resource="Refillable"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasWidestDiameterInMillimetres"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10.0</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="RetractableBallpointPen"/>
  <rdfs:subClassOf rdf:resource="RefillableBallpointPen"/>
  <rdfs:subClassOf rdf:resource="SlimBallpointPen"/>
</owl:Class>

<owl:Class rdf:about="RetractableMechanism">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:Class rdf:about="WritingImplement"/>

<owl:Class rdf:about="PenMake"/>

<owl:Class rdf:about="QuillPen">
  <rdfs:subClassOf rdf:resource="Pen"/>
</owl:Class>

<owl:Class rdf:about="RefillableBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="Refillable"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="RetractableBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasComponent"/>
          <owl:someValuesFrom rdf:resource="RetractableMechanism"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="RollerballPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="WaterBasedInk"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="SlimBallpointPen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Class>
          <owl:complementOf rdf:resource="ChunkyBallpointPen"/>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="SpacePen">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="BallpointPen"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="UnderWaterUsage"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="UpsideDownUsage"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasCharacteristic"/>
          <owl:hasValue rdf:resource="ZeroGravityUsage"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="BallpointPen"/>
</owl:Class>

<owl:Class rdf:about="UpperPenBody">
  <rdfs:subClassOf rdf:resource="PenComponent"/>
</owl:Class>

<owl:NamedIndividual rdf:about="Disposable">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Bic">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Customized">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Expensive">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Refillable">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="ErasableInk">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="UpsideDownUsage">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="UnderWaterUsage">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="ZeroGravityUsage">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Fisher">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Multicolour">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="WaterBasedInk">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Cheap">
  <rdf:type rdf:resource="PenCharacteristic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="ExampleBallpointPen1">
  <rdf:type rdf:resource="BallpointPen"/>
  <rdf:type rdf:resource="ChunkyBallpointPen"/>
  <hasWidestDiameterInMillimetres rdf:datatype="http://www.w3.org/2001/XMLSchema#float">13.8</hasWidestDiameterInMillimetres>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="ExampleBallpointPen2">
  <rdf:type rdf:resource="BallpointPen"/>
  <rdf:type rdf:resource="SlimBallpointPen"/>
  <hasWidestDiameterInMillimetres rdf:datatype="http://www.w3.org/2001/XMLSchema#float">12.0</hasWidestDiameterInMillimetres>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="PaperMate">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Parker">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Pentel">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Pilot">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Uniball">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Zebra">
  <rdf:type rdf:resource="PenMake"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="Pena_Bic_Cristal_Biru">
  <rdf:type rdf:resource="BicCristal"/>
  <hasCharacteristic rdf:resource="Disposable"/>
  <hasMake rdf:resource="Bic"/>
  <rdf:type rdf:resource="SlimBallpointPen"/>
  <hasWidestDiameterInMillimetres rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.5</hasWidestDiameterInMillimetres>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="PenCharacteristic"/>
    <rdf:Description rdf:about="PenComponent"/>
    <rdf:Description rdf:about="PenMake"/>
    <rdf:Description rdf:about="WritingImplement"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="BallpointPen"/>
    <rdf:Description rdf:about="FountainPen"/>
    <rdf:Description rdf:about="QuillPen"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="BallPoint"/>
    <rdf:Description rdf:about="BlindCap"/>
    <rdf:Description rdf:about="Cap"/>
    <rdf:Description rdf:about="InkReservoir"/>
    <rdf:Description rdf:about="LowerPenBody"/>
    <rdf:Description rdf:about="RetractableMechanism"/>
    <rdf:Description rdf:about="SinglePenBody"/>
    <rdf:Description rdf:about="Socket"/>
    <rdf:Description rdf:about="UpperPenBody"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
